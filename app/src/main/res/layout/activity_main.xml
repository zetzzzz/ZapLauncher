<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen: full-screen wallpaper, centered app grid, clock + date and
     a settings gear at the top right. Clean, minimal, functional. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_default"
        android:contentDescription="@null" />

    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/appGrid"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:paddingTop="110dp"
        android:paddingBottom="48dp"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="vertical"
        android:gravity="end"
        android:paddingTop="28dp"
        android:paddingEnd="36dp">

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/tile_bg"
            android:src="@drawable/ic_settings"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:contentDescription="@string/settings_button_desc" />

        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="20sp"
            android:textColor="@color/white_70" />

        <TextView
            android:id="@+id/clockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="@color/white" />
    </LinearLayout>
</FrameLayout>
