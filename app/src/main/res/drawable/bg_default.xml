<?xml version="1.0" encoding="utf-8"?>
<!-- Default wallpaper: dusk gradient, echoing a lavender field at sunset. -->
<!-- NOTE (v0.1.2): <gradient> must live inside <shape>. A bare <gradient> root -->
<!-- crashes at runtime (InflateException: Class not found gradient). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#6C5BB5"
        android:centerColor="#C97B9E"
        android:endColor="#7A5C9E"
        android:type="linear" />
</shape>
